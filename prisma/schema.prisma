generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ThreadStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum GeoFlag {
  DE
  GB
  IT
  FR
  GLOBAL
}

enum NotificationType {
  LIKE
  REPLY
  MENTION
  SYSTEM
  DIGEST
  STICKY
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  avatarUrl     String?
  bio           String?
  role          Role           @default(USER)
  geoFlag       GeoFlag        @default(GLOBAL)
  postCount     Int            @default(0)
  threadCount   Int            @default(0)
  likeCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  threads       Thread[]
  posts         Post[]
  likes         Like[]
  favorites     Favorite[]
  notifications Notification[]          @relation("NotificationReceiver")
  notified      Notification[]          @relation("NotificationActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?
  sortOrder   Int        @default(0)
  modelTags   String[]   @default([])
  threadCount Int        @default(0)
  postCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  threads       Thread[]
  banners       Banner[]
  productModels ProductModel[]

  @@index([parentId])
  @@index([slug])
}

model Thread {
  id            String       @id @default(cuid())
  title         String
  content       String       @db.Text
  excerpt       String?
  categoryId    String
  authorId      String
  prefix        String?
  isSticky      Boolean      @default(false)
  isDigest      Boolean      @default(false)
  heatScore     Int          @default(0)
  viewCount     Int          @default(0)
  likeCount     Int          @default(0)
  favCount      Int          @default(0)
  replyCount    Int          @default(0)
  geoFlag       GeoFlag?
  featureImage  String?
  status        ThreadStatus @default(ACTIVE)
  isPoll        Boolean      @default(false)
  isReward      Boolean      @default(false)
  modelTypeId   String?
  lastPostAt    DateTime?
  lastPostById  String?
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category   Category   @relation(fields: [categoryId], references: [id])
  author     User       @relation(fields: [authorId], references: [id])
  posts      Post[]
  likes      Like[]
  favorites  Favorite[]
  banners    Banner[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([isSticky, isDigest, heatScore])
  @@index([createdAt])
  @@index([lastPostAt])
  @@index([prefix])
  @@index([modelTypeId])
}

model Post {
  id        String    @id @default(cuid())
  content   String    @db.Text
  threadId  String
  authorId  String
  parentId  String?
  likeCount Int       @default(0)
  geoFlag   GeoFlag?
  floorNum  Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User   @relation(fields: [authorId], references: [id])
  parent   Post?  @relation("PostReplies", fields: [parentId], references: [id])
  replies  Post[] @relation("PostReplies")
  likes    Like[]

  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  postId    String?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@unique([userId, postId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  imageUrl   String
  linkUrl    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  categoryId String?
  threadId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
  thread   Thread?   @relation(fields: [threadId], references: [id])

  @@index([sortOrder])
  @@index([isActive])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  content   String?
  threadId  String?
  postId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model ProductModel {
  id         String   @id @default(cuid())
  name       String
  categoryId String
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id])

  @@unique([name, categoryId])
}

model Translation {
  id     String @id @default(cuid())
  key    String
  locale String
  value  String @db.Text

  @@unique([key, locale])
  @@index([locale])
}
